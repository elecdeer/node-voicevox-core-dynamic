{
  "name": "node-voicevox-core-dynamic",
  "version": "1.0.0",
  "description": "Node.js binding for voicevox_core using the built-in node:ffi module",
  "keywords": [
    "ffi",
    "node-ffi",
    "speech-synthesis",
    "tts",
    "voicevox"
  ],
  "license": "MIT",
  "author": "elecdeer",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix-suggestions",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "vp test run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vp test --config vitest.config.e2e.ts",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --exit-code-from e2e-test"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260204.1",
    "@vitest/ui": "catalog:",
    "typescript": "^5.7.3",
    "valibot": "^1.2.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "v26.5.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.1.0"
  },
  "packageManager": "pnpm@10.28.1"
}
